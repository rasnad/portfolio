---
import { navCopy } from "@/data/copy";
---

<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a class="brand brand-hidden" href="/" aria-label={navCopy.home.en} data-i18n-aria-en={navCopy.home.en} data-i18n-aria-es={navCopy.home.es}></a>
    <nav class="nav-links" aria-label={navCopy.mainNavigation.en} data-i18n-aria-en={navCopy.mainNavigation.en} data-i18n-aria-es={navCopy.mainNavigation.es}>
      <a href="/#proyectos" data-i18n-en={navCopy.work.en} data-i18n-es={navCopy.work.es}>{navCopy.work.en}</a>
      <a href="/#estudio" data-i18n-en={navCopy.about.en} data-i18n-es={navCopy.about.es}>{navCopy.about.en}</a>
      <a href="/#servicios" data-i18n-en={navCopy.services.en} data-i18n-es={navCopy.services.es}>{navCopy.services.en}</a>
      <a class="btn btn-primary nav-cta" href="/#contacto" data-i18n-en={navCopy.contactCta.en} data-i18n-es={navCopy.contactCta.es}>{navCopy.contactCta.en}</a>
    </nav>
    <div class="locale-switch" role="group" aria-label={navCopy.languageSwitch.en} data-i18n-aria-en={navCopy.languageSwitch.en} data-i18n-aria-es={navCopy.languageSwitch.es}>
      <button class="locale-btn is-active" type="button" data-locale-set="en">EN</button>
      <button class="locale-btn" type="button" data-locale-set="es">ES</button>
    </div>
    <button class="nav-toggle" type="button" aria-label={navCopy.openMenu.en} aria-expanded="false" data-nav-toggle data-i18n-aria-en={navCopy.openMenu.en} data-i18n-aria-es={navCopy.openMenu.es}>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="nav-sheet" data-nav-sheet>
  <a href="/#proyectos" data-i18n-en={navCopy.work.en} data-i18n-es={navCopy.work.es}>{navCopy.work.en}</a>
  <a href="/#estudio" data-i18n-en={navCopy.about.en} data-i18n-es={navCopy.about.es}>{navCopy.about.en}</a>
  <a href="/#servicios" data-i18n-en={navCopy.services.en} data-i18n-es={navCopy.services.es}>{navCopy.services.en}</a>
  <a href="/#contacto" data-i18n-en={navCopy.contact.en} data-i18n-es={navCopy.contact.es}>{navCopy.contact.en}</a>
  <a class="btn btn-primary" href="/#contacto" data-i18n-en={navCopy.contactCta.en} data-i18n-es={navCopy.contactCta.es}>{navCopy.contactCta.en}</a>
  <button
    class="locale-mobile-trigger"
    type="button"
    data-locale-modal-open
    aria-label={navCopy.languageSwitch.en}
    data-i18n-aria-en={navCopy.languageSwitch.en}
    data-i18n-aria-es={navCopy.languageSwitch.es}
    data-locale-label-en={navCopy.english.en}
    data-locale-label-es={navCopy.spanish.es}
  >
    <span class="locale-mobile-trigger-label" data-locale-current-label>{navCopy.english.en}</span>
  </button>
</div>

<div class="locale-modal" data-locale-modal hidden>
  <div class="locale-modal-backdrop" aria-hidden="true"></div>
  <div class="locale-modal-card" role="dialog" aria-modal="true" aria-label={navCopy.chooseLanguage.en} data-i18n-aria-en={navCopy.chooseLanguage.en} data-i18n-aria-es={navCopy.chooseLanguage.es}>
    <p class="locale-modal-kicker" data-i18n-en={navCopy.chooseLanguage.en} data-i18n-es={navCopy.chooseLanguage.es}>{navCopy.chooseLanguage.en}</p>
    <button class="locale-modal-option" type="button" data-locale-set="en" data-locale-modal-option>
      <span>{navCopy.english.en}</span>
    </button>
    <button class="locale-modal-option" type="button" data-locale-set="es" data-locale-modal-option>
      <span>{navCopy.spanish.es}</span>
    </button>
  </div>
</div>
